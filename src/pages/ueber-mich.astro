---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import portraitOffice from '../assets/portrait-office.png';

export const title = "Über mich - Michael Banditt";
export const description = "Michael Banditt: rund 12 Jahre Praxis in Service, Support und Prozessoptimierung – Automatisierung mit SAP S/4HANA, Dynamics CRM und Power Automate, Projektarbeit und Coaching.";
export const pageStyle = "about-page.css";
---

<BaseLayout title={title} description={description} pageStyle={pageStyle}>
  <Header active="about" />

  <main class="about-page-modern">
    <section class="profile-hero-modern">
      <div class="profile-hero-copy">
        <span class="section-eyebrow">Über mich</span>
        <h1>Ich bereite Supportteams auf den Alltag am Ticket vor.</h1>
        <p class="profile-lead">
          Mein Hintergrund ist der Support selbst: 20 Jahre Berufserfahrung im Kundensupport
          und über 12 Jahre in der Prozessoptimierung. Heute verbinde ich beides als Trainer
          in der Erwachsenenbildung.
        </p>

        <div class="hero-actions">
          <a href="/#trainingsvorlagen" class="cta-button">Trainingsvorlagen ansehen</a>
          <a href="#stationen" class="secondary-button">Stationen ansehen</a>
        </div>
      </div>

      <aside class="profile-hero-card">
        <Image
          src={portraitOffice}
          alt="Michael Banditt im Büro"
          class="profile-image-modern"
          width={900}
          format="webp"
          quality={80}
          loading="eager"
        />

        <div class="profile-facts">
          <div class="fact-item">
            <span class="fact-label">Schwerpunkt</span>
            <strong>Trainings und Trainingsunterlagen für IT-Supportteams</strong>
          </div>
          <div class="fact-item">
            <span class="fact-label">Arbeitsstil</span>
            <strong>analytisch, pragmatisch, menschenorientiert</strong>
          </div>
          <div class="fact-item">
            <span class="fact-label">Qualifikation</span>
            <strong>Train the Trainer (TÜV®), TÜV NORD CERT GmbH</strong>
          </div>
        </div>

        <blockquote class="profile-quote">
          „Komplexität reduzieren. Lösungen anschlussfähig machen.“
        </blockquote>
      </aside>
    </section>

    <section class="proof-strip">
      <article class="proof-card">
        <span class="proof-number">20</span>
        <p>Jahre Berufserfahrung im Kundensupport</p>
      </article>
      <article class="proof-card">
        <span class="proof-number">12+</span>
        <p>Jahre in der Prozessoptimierung</p>
      </article>
      <article class="proof-card">
        <span class="proof-number">2026</span>
        <p>seit September zertifiziert als Train the Trainer (TÜV®)</p>
      </article>
    </section>

    <section class="section-block section-split" id="qualifikation">
      <div>
        <span class="section-eyebrow">Qualifikation</span>
        <h2>Train the Trainer (TÜV®)</h2>
      </div>

      <div>
        <p class="section-intro">
          Seit September 2026 bin ich zertifiziert als Train the Trainer (TÜV®) durch die
          TÜV NORD CERT GmbH. Die Zertifizierung ergänzt, was ich vorher schon getan habe:
          Kolleginnen und Kollegen in neue Systeme und Abläufe einarbeiten und neue
          Mitarbeitende fachlich begleiten.
        </p>
        <p class="about-qualification-note">
          <strong>Hinweis:</strong>{" "}
          Das Zertifikat ist eine persönliche Qualifikation. Meine Trainingsunterlagen gebe
          ich selbst heraus; sie wurden nicht von TÜV NORD oder anderen Dritten geprüft.
        </p>
      </div>
    </section>

    <section class="section-block">
      <div class="section-heading">
        <span class="section-eyebrow">Profil</span>
        <h2>Wofür ich stehe</h2>
        <p>
          Nicht für abstrakte Konzepte, sondern für Verbesserungen, die im Alltag verstanden,
          angenommen und genutzt werden.
        </p>
      </div>

      <div class="pillar-grid">
        <article class="pillar-card">
          <h3>Komplexität greifbar machen</h3>
          <p>
            Ich strukturiere unübersichtliche Situationen und arbeite heraus,
            wo die eigentlichen Ursachen und Hebel liegen.
          </p>
        </article>
        <article class="pillar-card">
          <h3>Prozesse praktikabel neu ordnen</h3>
          <p>
            Ich denke in realen Verantwortlichkeiten, funktionierenden Abläufen
            und Lösungen, die Teams wirklich entlasten.
          </p>
        </article>
        <article class="pillar-card">
          <h3>Veränderung verständlich begleiten</h3>
          <p>
            Ich vermittle neue Arbeitsweisen so, dass daraus nicht nur ein Plan,
            sondern ein nutzbarer Standard wird.
          </p>
        </article>
      </div>
    </section>

    <section class="section-block" id="stationen">
      <div class="section-heading">
        <span class="section-eyebrow">Stationen</span>
        <h2>Beruflicher Weg</h2>
        <p>Mein Profil ist aus Praxis, Optimierungsarbeit und technischer Anschlussfähigkeit gewachsen.</p>
      </div>

      <div class="timeline-modern">
        <article class="timeline-entry">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <h3>Shiftmove GmbH</h3>
            <p class="timeline-role">Kundensupport, Prozessvereinfachung, interne Toolentwicklung</p>
            <p>
              Mitarbeit im Simplifizierungsprojekt mit Fokus auf interne Lösungen — unter anderem
              an einem internen Tool zur Fahrtenbuchbearbeitung. Eingebrachte Ideen wurden
              aufgenommen und umgesetzt; dazu Einarbeitung und fachliche Begleitung neuer
              Mitarbeitender sowie Sparring bei komplexeren Fragestellungen.
            </p>
          </div>
        </article>
        <article class="timeline-entry">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <h3>Lohnexperte AG</h3>
            <p class="timeline-role">Projektmanager</p>
            <p>
              Projektkoordination, Stakeholder-Abstimmung und strukturierte Lösungsentwicklung
              in Konstellationen, in denen Überblick, Klarheit und saubere Kommunikation entscheidend sind.
            </p>
          </div>
        </article>
        <article class="timeline-entry">
          <div class="timeline-marker"></div>
          <div class="timeline-content">
            <h3>Foundever B.V. & Co. KG / vormals SITEL GmbH</h3>
            <p class="timeline-role">Kundenservice, technischer Support, Angebotsmanagement, Prozessoptimierung · ca. 12 Jahre</p>
            <p>
              Vom First- und Second-Level-Support bis ins Angebotsmanagement für Geschäftskunden
              (Drucker- und Computerservices). Als die Anfragenlast den manuellen Angebotsprozess
              an seine Grenzen brachte, Mitwirkung an dessen Automatisierung durch die Integration
              von SAP S/4HANA, Microsoft Dynamics CRM und Microsoft Power Automate — mit spürbar
              schnelleren Angeboten für Kunden und deutlicher Entlastung von repetitiven Tätigkeiten.
              Am Ende war der Prozess so gründlich automatisiert, dass sich das Team für diese
              Aufgabe selbst überflüssig machte.
            </p>
          </div>
        </article>   
        
      </div>
    </section>

    <section class="section-block section-split">
      <div>
        <span class="section-eyebrow">Arbeitsweise</span>
        <h2>Wie ich Trainings aufbaue</h2>
      </div>

      <div class="method-list">
        <article class="method-item">
          <span>01</span>
          <div>
            <h3>Vom echten Ticket ausgehen</h3>
            <p>Ich beginne mit der Situation, wie sie im Support ankommt: unvollständig, unter Zeitdruck, mit einer Vermutung des Anrufers.</p>
          </div>
        </article>
        <article class="method-item">
          <span>02</span>
          <div>
            <h3>Den Weg üben, nicht die Klickfolge</h3>
            <p>Rückfragen stellen, Hypothesen prüfen, Grenzen erkennen und sauber übergeben. Fachlich begründete Alternativen sind zugelassen.</p>
          </div>
        </article>
        <article class="method-item">
          <span>03</span>
          <div>
            <h3>Gemeinsam auswerten</h3>
            <p>Ein Bewertungsbogen gibt Trainer und Team eine gemeinsame Grundlage für das Gespräch nach der Übung.</p>
          </div>
        </article>
      </div>
    </section>

    <section class="section-block">
      <div class="section-heading">
        <span class="section-eyebrow">Kompetenzen</span>
        <h2>Ausgewählte fachliche Schwerpunkte</h2>
      </div>

      <div class="tag-groups">
        <div class="tag-group">
          <h3>Training &amp; Erwachsenenbildung</h3>
          <div class="tag-list">
            <span>Train the Trainer</span>
            <span>Erwachsenenbildung</span>
            <span>Fallbasiertes Üben</span>
            <span>Einarbeitung</span>
            <span>Wissensvermittlung</span>
          </div>
        </div>
        <div class="tag-group">
          <h3>Prozess &amp; Organisation</h3>
          <div class="tag-list">
            <span>Prozessoptimierung</span>
            <span>Prozessautomatisierung</span>
            <span>Projektmanagement</span>
            <span>Stakeholder-Management</span>
            <span>Scrum / agile Zusammenarbeit</span>
          </div>
        </div>
        <div class="tag-group">
          <h3>Systeme &amp; Tools</h3>
          <div class="tag-list">
            <span>Zendesk</span>
            <span>Intercom / Fin</span>
            <span>HubSpot</span>
            <span>Salesforce</span>
            <span>Microsoft Dynamics CRM</span>
            <span>Microsoft Power Automate</span>
            <span>Jira</span>
            <span>YouTrack</span>
            <span>n8n</span>
            <span>Linux</span>
            <span>LLMs &amp; KI-Assistenten</span>
          </div>
        </div>
        <div class="tag-group">
          <h3>Zusammenarbeit &amp; Enablement</h3>
          <div class="tag-list">
            <span>Coaching</span>
            <span>Mentoring</span>
            <span>Technischer Support</span>
          </div>
        </div>
      </div>
    </section>

    <section class="about-cta-panel">
      <div>
        <span class="section-eyebrow">Nächster Schritt</span>
        <h2>Fragen zu Trainings oder Trainingsvorlagen? Schreib mir.</h2>
        <p>
          Ein paar Sätze zu deinem Anliegen reichen. Ich freue mich über deine Nachricht.
        </p>
      </div>
      <a href="/kontakt" class="cta-button">Jetzt Kontakt aufnehmen</a>
    </section>
  </main>

  <Footer />
</BaseLayout>