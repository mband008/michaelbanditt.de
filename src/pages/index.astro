---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import portraitHeadshot from '../assets/portrait-headshot.png';
import { firmenhandys } from '../data/trainingsvorlagen';

const title = "Michael Banditt - Problemlöser für Prozesse, Menschen und Systeme";
const description = "Michael Banditt – Problemlöser für Prozesse, Menschen und Systeme. Prozessoptimierung, Automatisierung (u. a. Power Automate, n8n) und Change-Begleitung aus operativer Praxis.";
const pageStyle = "home-page.css";
---

<BaseLayout {title} {description} {pageStyle}>
  <Header active="home" />

  <main class="home-page-modern">
    <section class="home-hero-modern">
      <div class="home-hero-copy">
        <span class="section-eyebrow">Michael Banditt · Trainer für IT-Support</span>
        <h1>Support trainieren. Mit Fällen aus dem Alltag.</h1>
        <p class="hero-lead">
          Ich bin Trainer für Erwachsenenbildung mit Schwerpunkt IT-Support. Ich entwickle
          Trainingsunterlagen, mit denen Teamleitungen und interne Trainer ihre Supportkräfte auf
          typische Tickets vorbereiten können: mit gezielten Rückfragen, nachvollziehbaren
          Diagnosewegen und Lösungen für die Auswertung.
        </p>

        <div class="hero-actions">
          <a href="#trainingsvorlagen" class="cta-button">Trainingsvorlagen ansehen</a>
          <a href="/ueber-mich" class="secondary-button">Mehr über mich</a>
        </div>

        <div class="hero-trust-list" aria-label="Schwerpunkte">
          <span>IT-Support</span>
          <span>Erwachsenenbildung</span>
          <span>Train the Trainer</span>
          <span>Prozessoptimierung</span>
        </div>
      </div>

      <aside class="home-hero-card">
        <Image
          src={portraitHeadshot}
          alt="Porträt von Michael Banditt"
          class="home-profile-image"
          width={504}
          format="webp"
          quality={80}
          loading="eager"
        />

        <div class="hero-card-content">
          <h2>Kurzprofil</h2>
          <div class="hero-focus-list">
            <article>
              <strong>20 Jahre Kundensupport</strong>
              <p>Berufserfahrung im Kundensupport.</p>
            </article>
            <article>
              <strong>Über 12 Jahre Prozessoptimierung</strong>
              <p>Abläufe vereinfachen, Übergaben klären, Routine automatisieren.</p>
            </article>
            <article>
              <strong>Train the Trainer (TÜV®)</strong>
              <p>Zertifikat der TÜV NORD CERT GmbH, seit September 2026.</p>
            </article>
          </div>
        </div>
      </aside>
    </section>

    <section class="section-block home-trainingsvorlagen" id="trainingsvorlagen">
      <div class="section-heading">
        <span class="section-eyebrow">Trainingsvorlagen</span>
        <h2>Übungsfälle für IT-Supportteams</h2>
        <p>
          Fertige Trainingsunterlagen für die Einarbeitung und Weiterbildung im Support.
          Teilnehmende arbeiten am Ticket, Trainer erhalten die verdeckten Befunde, einen
          Lösungsweg und einen Bewertungsbogen.
        </p>
      </div>

      <article class="home-product-card">
        {!firmenhandys.landingOeffentlich && <span class="home-product-status">Vorschau</span>}
        <h3 class="home-product-title">{firmenhandys.titel}</h3>
        <p>{firmenhandys.kurztext}</p>
        <p class="home-product-note">{firmenhandys.kennzeichnung}</p>
        {firmenhandys.landingOeffentlich
          ? <a href={firmenhandys.url} class="cta-button">Zur Produktseite</a>
          : <p class="home-product-pending">Die Produktseite wird in Kürze veröffentlicht.</p>}
      </article>
    </section>

    <section class="section-block">
      <div class="section-heading">
        <span class="section-eyebrow">Aufbau</span>
        <h2>So sind meine Trainingsunterlagen aufgebaut</h2>
      </div>

      <div class="service-grid">
        <article class="service-card">
          <h3>Fälle aus dem Supportalltag</h3>
          <p>
            Fiktive Tickets mit Gesprächsverlauf, wie sie im First-Level-Support ankommen.
          </p>
        </article>
        <article class="service-card">
          <h3>Methodik vor Technik</h3>
          <p>
            Geübt werden Rückfragen, Hypothesen, Grenzen, Eskalation und Kommunikation.
            Technische Details nur, soweit Herstellerquellen sie belegen.
          </p>
        </article>
        <article class="service-card">
          <h3>Getrennte Unterlagen für Teilnehmende und Trainer</h3>
          <p>
            Teilnehmende sehen den Auftrag, Trainer zusätzlich die Befunde, einen Lösungsweg
            und den Bewertungsbogen.
          </p>
        </article>
      </div>
    </section>

    <section class="section-block">
      <div class="section-heading">
        <span class="section-eyebrow">Praxisbezug</span>
        <h2>Worauf meine Trainings aufbauen</h2>
        <p>
          Stationen aus Kundensupport, Prozessoptimierung und Projektarbeit.
        </p>
      </div>

      <div class="proof-strip" aria-label="Praxisbeispiele">
        <article class="proof-card">
          <span class="proof-label">Foundever B.V. & Co. KG / vormals SITEL GmbH</span>
          <p>Automatisierung des Angebotsmanagements für Geschäftskunden mit SAP S/4HANA, Dynamics CRM und Power Automate — schnellere Angebote, weniger Routinearbeit.</p>
        </article>
        <article class="proof-card">
          <span class="proof-label">Shiftmove GmbH</span>
          <p>Mitarbeit im Simplifizierungsprojekt, u. a. an einem internen Tool zur Fahrtenbuchbearbeitung — Ideen, die im Alltag genutzt werden.</p>
        </article>
        <article class="proof-card">
          <span class="proof-label">Lohnexperte AG</span>
          <p>Als Projektmanager verantwortlich für Projektkoordination und Stakeholder-Management in komplexen Konstellationen.</p>
        </article>
      </div>
    </section>

    <section class="cta-panel">
      <div>
        <span class="section-eyebrow">Nächster Schritt</span>
        <h2>Am besten starten wir mit einer kurzen, konkreten Nachricht.</h2>
        <p>
          Wenn du eine Frage zu Trainings oder Trainingsvorlagen hast, freue ich mich über deine Nachricht.
        </p>
      </div>

      <div class="cta-panel-actions">
        <a href="/ueber-mich" class="secondary-button">Profil ansehen</a>
        <a href="/kontakt" class="cta-button">Kontakt</a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
